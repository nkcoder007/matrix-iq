# Server port
PORT=8787

# Session inactivity TTL in milliseconds (default: 30 minutes)
SESSION_TTL_MS=1800000

# How often expired sessions are reaped, in milliseconds (default: 5 minutes)
SESSION_SWEEP_MS=300000

# Maximum size of a single uploaded file or pasted document, in bytes
# (default: 10 MiB).
UPLOAD_MAX_BYTES=10485760

# Maximum number of pages accepted from a PDF (default: 200).
PDF_MAX_PAGES=200

# Comma-separated browser origins allowed to call the API directly.
# The Vite dev proxy uses same-origin requests and does not need an entry here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini analysis. Keep this key server-side; never put it in a VITE_*
# variable or commit it. Analysis is disabled with a clear API error when empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# AI request timeout and source-text budgets sent to the provider.
AI_TIMEOUT_MS=45000
AI_MAX_DOCUMENT_CHARS=12000
AI_MAX_TOTAL_CHARS=60000
