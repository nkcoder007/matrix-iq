# Local browser mode is the default. Projects, source text and preferences stay
# in IndexedDB and no network request is made.
VITE_API_MODE=local

# Set both values to use the backend. The API client bootstraps an in-memory
# session through POST /session and keeps its ID in sessionStorage.
# VITE_API_MODE=remote
# VITE_API_BASE_URL=http://localhost:8787

# Optional: proxy /api to a local backend during development. Keep
# VITE_API_BASE_URL=/api when using the proxy.
# VITE_API_PROXY_TARGET=http://localhost:8787
